# Benchmark output (regenerated by `docker compose run measure`)
measure/results/*
!measure/results/.gitkeep

# Trained models (regenerated by the pipeline, shared with app via a bind mount)
models/*
!models/.gitkeep

# Python
__pycache__/
*.pyc
venv/
.venv/

# OS
.DS_Store
